# The Express API's settings. Copy to api/.env for local development; in production
# they live in the .env beside the server's docker-compose.yml. Placeholders only:
# never commit a real value.

PORT=3000

# How many proxies sit in front of this API, so req.ip is the visitor rather than
# the proxy. 0 or unset trusts nothing: every visitor then shares one rate-limit
# bucket, and no visitor address is forwarded to the assistant. 1 trusts Traefik.
# 2 trusts Traefik and Cloudflare, which is correct only once Traefik itself trusts
# Cloudflare's addresses (forwardedHeaders.trustedIPs on its entrypoint). A list of
# addresses and ranges also works. "true", "*" and counts above 2 are refused,
# because they would let a visitor choose their own address. Unset for local use.
TRUST_PROXY=

# The AI assistant (the portfolio-ai service). Leave the URL empty and the chat
# routes answer 503: that is how they deploy switched off. In production the URL is
# the service on the shared Docker network, http://portfolio-ai:8000; locally, the
# API run with `uv run python -m portfolio_ai.api`, http://127.0.0.1:8000.
PORTFOLIO_AI_URL=
# Must be identical to PORTFOLIO_AI_API_KEY in the assistant's own .env, and at
# least 32 characters. The browser never sees it.
PORTFOLIO_AI_API_KEY=

# The contact form: an n8n webhook that emails the message, and reCAPTCHA v3. An
# empty RECAPTCHA_SECRET_KEY switches verification off, which is meant for local use.
N8N_WEBHOOK_URL=
N8N_API_KEY=
N8N_CONTACT_WEBHOOK_PATH=/contact
RECAPTCHA_SECRET_KEY=
